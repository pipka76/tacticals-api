{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5000"
      }
    }
  },
  "GameServers": {
    "ExecutablePath": "./tacticals-server",
    "Arguments": "--headless -- --port={port} --battle={battleId}",
    "WorkingDirectory": ".",
    "PublicHost": "127.0.0.1",
    "MinPort": 20000,
    "MaxPort": 20099,
    "StartupTimeoutSeconds": 30,
    "ReadyMarker": "Server Started!"
  }
}
